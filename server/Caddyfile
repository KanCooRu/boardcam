# Front door of one server. SITE_ADDRESS in .env decides how it listens:
#   :80                  behind the Lightsail load balancer (the balancer holds the certificate), or by IP for testing
#   game.example.com     standing alone: Caddy gets and renews the HTTPS certificate by itself
{$SITE_ADDRESS} {
	encode zstd gzip
	# The balancer and the uptime monitor ask this; it is not logged.
	@health path /health
	handle @health {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy api:3000 {
			header_up X-Real-IP {remote_host}
			# A server that is restarting drops out for a few seconds; wait for it instead of failing at once.
			lb_try_duration 5s
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
		level WARN
	}
}
