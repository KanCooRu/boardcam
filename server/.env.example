# Copy to .env on each server (cp .env.example .env && chmod 600 .env) and fill in.
# Never commit .env. Values here are examples, not secrets.

# --- How the server is reached ---
# ":80" behind the load balancer or for testing by IP; a domain name to let Caddy handle HTTPS by itself.
SITE_ADDRESS=:80
# The address players use, with https. Leave empty while testing by IP address.
PUBLIC_ORIGIN=

# --- Database ---
# Managed PostgreSQL (production):  postgres://game_app:PASSWORD@ENDPOINT:5432/game?sslmode=require
# Container database (test server, with --profile localdb):  postgres://game_app:PASSWORD@postgres:5432/game
DATABASE_URL=postgres://game_app:change-me@postgres:5432/game
LOCAL_DB_PASSWORD=change-me
# Connections each process keeps open: DB_POOL for queries and DB_LOCK_POOL for per-player ordering.
# processes x servers x (DB_POOL + DB_LOCK_POOL) must stay under the database's connection limit.
DB_POOL=12
DB_LOCK_POOL=8

# --- Sign-in ---
# guest: a signed cookie per browser (testing). firebase: players sign in; the server checks the ID token.
AUTH_MODE=guest
# 32+ random characters. Make one with:  openssl rand -base64 32
GUEST_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Capacity ---
# How old a power or stage ranking may be, in seconds. 0 asks the database on every request.
RANK_CACHE_SECONDS=30
# Processes per server. Empty means one per CPU.
WORKERS=

# --- Backups and alerts (scripts/backup-db.sh, scripts/disk-check.sh) ---
S3_BUCKET=
AWS_REGION=ap-northeast-2
SNS_TOPIC_ARN=

# --- Redis (only with --profile redis) ---
REDIS_PASSWORD=
